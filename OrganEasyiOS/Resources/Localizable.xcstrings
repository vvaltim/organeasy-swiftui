          "stringUnit": {
            "state": "translated",
            "value": "The score compares this asset with others in the sector, based on your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota compara este activo con los demás del sector, según tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note compare cet actif aux autres du secteur, selon votre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il voto confronta questo titolo con gli altri del settore, in base al tuo profilo."
          }
        }
      }
    },
