    "%@: %lld compras somam %@ neste mês. Comprar menos vezes é o corte mais fácil.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld purchases add up to %@ this month. Buying less often is the easiest cut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld compras suman %@ este mes. Comprar menos veces es el recorte más fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ : %lld achats totalisent %@ ce mois-ci. Acheter moins souvent est l’économie la plus simple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld acquisti per un totale di %@ questo mese. Comprare meno spesso è il taglio più facile."
          }
        }
      }
    },
