    "Você paga %@ pelo primeiro ano. Depois, a assinatura renova automaticamente por %@ ao ano, até ser cancelada nos Ajustes com pelo menos 24 horas de antecedência.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You pay %1$@ for the first year. After that, the subscription renews automatically at %2$@ per year until canceled in Settings at least 24 hours in advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagas %1$@ el primer año. Después, la suscripción se renueva automáticamente por %2$@ al año hasta que se cancele en Ajustes con al menos 24 horas de antelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous payez %1$@ la première année. Ensuite, l’abonnement se renouvelle automatiquement à %2$@ par an jusqu’à son annulation dans Réglages au moins 24 heures à l’avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghi %1$@ per il primo anno. In seguito l’abbonamento si rinnova automaticamente a %2$@ all’anno fino alla disdetta in Impostazioni con almeno 24 ore di anticipo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você paga %1$@ pelo primeiro ano. Depois, a assinatura renova automaticamente por %2$@ ao ano, até ser cancelada nos Ajustes com pelo menos 24 horas de antecedência."
          }
        }
      }
    },
