    "%@ por %@. A assinatura renova automaticamente até ser cancelada nos Ajustes, com pelo menos 24 horas de antecedência.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ per %@. The subscription renews automatically until canceled in Settings at least 24 hours in advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ por %@. La suscripción se renueva automáticamente hasta que se cancele en Ajustes con al menos 24 horas de antelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ par %@. L’abonnement se renouvelle automatiquement jusqu’à son annulation dans Réglages, au moins 24 heures à l’avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al %@. L’abbonamento si rinnova automaticamente finché non viene annullato in Impostazioni con almeno 24 ore di anticipo."
          }
        }
      }
    },
