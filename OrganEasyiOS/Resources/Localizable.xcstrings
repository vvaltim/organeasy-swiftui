            "state": "translated",
            "value": "Gives more weight to recent price moves, including smaller companies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Da más peso al movimiento reciente del precio, incluso en empresas más pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne plus de poids aux mouvements récents du cours, y compris des petites entreprises."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dà più peso ai movimenti recenti del prezzo, anche di aziende più piccole."
          }
        }
      }
    },
