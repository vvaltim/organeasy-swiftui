    "A assinatura renova automaticamente por %@ ao ano, até ser cancelada nos Ajustes com pelo menos 24 horas de antecedência.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription renews automatically at %@ per year until canceled in Settings at least 24 hours in advance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente por %@ al año hasta que se cancele en Ajustes con al menos 24 horas de antelación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement se renouvelle automatiquement à %@ par an jusqu’à son annulation dans Réglages au moins 24 heures à l’avance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento si rinnova automaticamente a %@ all’anno fino alla disdetta in Impostazioni con almeno 24 ore di anticipo."
          }
        }
      }
    },
