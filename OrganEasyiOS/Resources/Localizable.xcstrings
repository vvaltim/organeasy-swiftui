    "Use se os gastos aparecerem como entradas. Tudo entra como pago, na data do extrato.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this if expenses show up as income. Everything is added as paid, on the statement date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Úsalo si los gastos aparecen como ingresos. Todo se añade como pagado, en la fecha del extracto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À utiliser si les dépenses apparaissent comme des entrées. Tout est ajouté comme payé, à la date du relevé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usalo se le spese appaiono come entrate. Tutto viene aggiunto come pagato, alla data dell’estratto conto."
          }
        }
      }
    },
