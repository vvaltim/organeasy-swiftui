    "%@ se repete todo mês e custa %@ por ano. Veja se ainda vale a pena.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ repeats every month and costs %@ a year. See if it’s still worth it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se repite cada mes y cuesta %@ al año. Mira si aún vale la pena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ revient chaque mois et coûte %@ par an. Vérifiez si cela vaut encore la peine."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si ripete ogni mese e costa %@ all’anno. Vedi se ne vale ancora la pena."
          }
        }
      }
    },
